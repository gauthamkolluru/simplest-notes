// Copy this file to Secrets.xcconfig (gitignored) and paste your Google Cloud
// iOS OAuth client values. See docs/SETUP.md § "Paste your OAuth client ID".
//
// From Google Cloud Console → APIs & Services → Credentials → your iOS client:
//   Client ID looks like: 123456789-abcdefg.apps.googleusercontent.com
//   Reversed client ID:   com.googleusercontent.apps.123456789-abcdefg

GOOGLE_CLIENT_ID = PASTE_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.PASTE_IOS_CLIENT_ID
